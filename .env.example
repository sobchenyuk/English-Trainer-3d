# Скопируйте в .env и поменяйте под себя:  cp .env.example .env
# Все переменные необязательны: без .env используются значения по умолчанию.

# Порт на хосте, на котором будет доступен тренажёр
HOST_PORT=38417

# На каком адресе хоста слушать порт.
# 0.0.0.0   — доступен из сети (по IP сервера)
# 127.0.0.1 — только локально (удобно за Cloudflare Tunnel / reverse proxy)
BIND_ADDRESS=0.0.0.0

# Имя контейнера (видно в docker ps; по нему обращается cloudflared/proxy в общей сети)
CONTAINER_NAME=english-trainer-3d

# Образ: локальная сборка или готовый образ из GHCR
IMAGE=ghcr.io/sobchenyuk/english-trainer-3d:latest

# Часовой пояс контейнера (время в логах nginx)
TZ=Europe/Kyiv
